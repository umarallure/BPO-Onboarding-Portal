# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Your production board ID: 8595002703 (already set as default)
# Only override this if you want to use a different board for testing
# VITE_MONDAY_BOARD_ID=8595002703

# Instantly AI Analytics
# Generate at: app.instantly.ai → Settings → API Keys
# Required scope: campaigns:read
VITE_INSTANTLY_API_KEY=your_instantly_api_key_here

# Slack launcher configuration
# Public URL only. Do not put Slack tokens in VITE_ variables.
VITE_SLACK_WORKSPACE_URL=your_slack_workspace_url_here

# BPO portal launcher configuration
# Local BPO portal example: http://localhost:3000
VITE_BPO_PORTAL_URL=your_bpo_portal_base_url_here
